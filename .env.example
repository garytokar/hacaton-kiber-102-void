# Настройки сервера
PORT=8000
SECRET_KEY=yanlander-super-secret-key-bashkir-preservation-2026

# База данных PostgreSQL (для Docker Compose)
PG_USER=postgres
PG_PASSWORD=secret
PG_DB=bashkir_school
DATABASE_URL=postgresql+psycopg://postgres:secret@postgres:5432/bashkir_school

# Для локального запуска без Docker можно использовать встроенную SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./yanlander.db

# Telegram-бот (опционально)
TELEGRAM_BOT_TOKEN=
