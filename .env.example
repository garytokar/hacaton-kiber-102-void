# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=ur_tg_token

# Режим работы бота: "polling" для локальной разработки
BOT_MODE=polling

# URL мини-приложения (Mini App)
WEBAPP_URL=https://example.com/app

# Настройки сервера и баз
PORT=8080
PG_USER=postgres
PG_PASSWORD=secret
PG_DB=bashkir_school
DATABASE_URL=postgres://postgres:secret@postgres:5432/bashkir_school?sslmode=disable
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=bashkir-school-hackathon-jwt-secret-2026