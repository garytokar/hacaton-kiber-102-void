[
    {
        "id":  "bgpu-kk-00001",
        "text_ba":  "Һаумыһығыҙ!",
        "text_ru":  "Здравствуйте!",
        "text_other":  "Сәламатсыз ба?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00002",
        "text_ba":  "Хәйерле көн (иртә, кис)!",
        "text_ru":  "Добрый(-ое) день (утро, вечер)!",
        "text_other":  "Қайырлы күн (таң, кеш)!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00003",
        "text_ba":  "Сәләм!",
        "text_ru":  "Привет!",
        "text_other":  "Сәлем!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00004",
        "text_ba":  "Рәхим итегеҙ!",
        "text_ru":  "Добро пожаловать!",
        "text_other":  "Қош келдіңіз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00005",
        "text_ba":  "Мин һеҙҙе күреүемә шатмын!",
        "text_ru":  "Я рад(-а) вас видеть!",
        "text_other":  "Сізді көргеніме қуаныштымын!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00006",
        "text_ba":  "Һеҙҙең хәлдәрегеҙ нисек?",
        "text_ru":  "Как у вас дела?",
        "text_other":  "Қалыңыз қалай?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00007",
        "text_ba":  "Бөтәһе лә яҡшы",
        "text_ru":  "Все хорошо",
        "text_other":  "Бәрі жақсы",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00008",
        "text_ba":  "Һеҙ нисек йәшәп ятаһығыҙ?",
        "text_ru":  "Как вы поживаете?",
        "text_other":  "Жағдайыңыз қалай?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00009",
        "text_ba":  "Шәптән түгел",
        "text_ru":  "Так себе",
        "text_other":  "Болады",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00010",
        "text_ba":  "Бик йәл!",
        "text_ru":  "Очень жаль!",
        "text_other":  "Өте өкінішті!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00011",
        "text_ba":  "Һаулығығыҙ нисек?",
        "text_ru":  "Как здоровье?",
        "text_other":  "Денсаулығыңыз қалай?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00012",
        "text_ba":  "Рәхмәт, яҡшы",
        "text_ru":  "Спасибо, хорошо",
        "text_other":  "Рахмет, жақсы",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00013",
        "text_ba":  "Аллаға шөкөр, яҡшы!",
        "text_ru":  "Слава богу, хорошо!",
        "text_other":  "Құдайға шүкір, жақсы!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00014",
        "text_ba":  "Ғаиләгеҙ ни хәлдә?",
        "text_ru":  "Как ваша семья?",
        "text_other":  "Отбасыңыз қалай?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00015",
        "text_ba":  "Бөтәһе лә иҫән-һау",
        "text_ru":  "Все живы-здоровы",
        "text_other":  "Бәрі аман-сау",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00016",
        "text_ba":  "Ҡасан килдегеҙ?",
        "text_ru":  "Когда приехали?",
        "text_other":  "Қашан келдіңіз?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00017",
        "text_ba":  "Беҙ бөгөн килдек",
        "text_ru":  "Мы приехали сегодня",
        "text_other":  "Біз бүгін келдік",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00018",
        "text_ba":  "Һеҙҙе күптән күргәнем юҡ ине",
        "text_ru":  "Давно вас не видел (-а)",
        "text_other":  "Сізді көптен көргенім жоқ",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00019",
        "text_ba":  "Күршеләр нисек?",
        "text_ru":  "Как соседи?",
        "text_other":  "Көршілер қалай?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00020",
        "text_ba":  "Яҡшы! Бөтәһе лә иҫән-һау!",
        "text_ru":  "Нормально! Все здоровы!",
        "text_other":  "Жақсы! Бәрі аман!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00021",
        "text_ba":  "Барыһы ла яҡшы!",
        "text_ru":  "Все хорошо!",
        "text_other":  "Бәрі жақсы!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00022",
        "text_ba":  "Таныш булайыҡ!",
        "text_ru":  "Будем знакомы!",
        "text_other":  "Танысып қояйық!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00023",
        "text_ba":  "Минең исемем Айһылыу Мырҙабаева",
        "text_ru":  "Меня зовут Айсылу Мурзабаева",
        "text_other":  "Менің есімім Айсылу Мырзабаева",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00024",
        "text_ba":  "Һеҙҙең менән танышыуға бик шатмын",
        "text_ru":  "Очень рад(-а) с вами познакомиться",
        "text_other":  "Сізбен танысқаныма өте қуаныштымын",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00025",
        "text_ba":  "Рәхмәт, мин дә шатмын!",
        "text_ru":  "Спасибо, я тоже рад (-а)!",
        "text_other":  "Рахмет, мен де қуаныштымын!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00026",
        "text_ba":  "Минең исемем Лилиә",
        "text_ru":  "Мое имя Лилия",
        "text_other":  "Менің есімім Лилия",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00027",
        "text_ba":  "Минең дуҫым, ирем (ҡатыным), ағайым (апайым), ҡустым (һеңлем) менән таныштырырға рөхсәт итегеҙ",
        "text_ru":  "Разрешите представить моего друга, мужа (жену), старшего брата (старшую сестру), младшего брата (младшую сестру)",
        "text_other":  "Менің досымды, жолдасымды (әйелімді), ағамды (апамды), інімді (сіңілімді) таныстыруға рұқсат етіңіз",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00028",
        "text_ba":  "Был минең өсөн оло хөрмәт",
        "text_ru":  "Это большая честь для меня",
        "text_other":  "Бұл мен үшін үлкен құрмет",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00029",
        "text_ba":  "Һеҙҙең турала мин күп ишеткәнем бар",
        "text_ru":  "Я много слышал(-а) о Вас",
        "text_other":  "Мен сіз туралы көп естідім",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00030",
        "text_ba":  "Мин Сибай ҡалаһында йәшәйем",
        "text_ru":  "Я живу в городе Сибай",
        "text_other":  "Мен Сибай қаласында тұрамын",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00031",
        "text_ba":  "Һеҙ ҡайҙан килдегеҙ?",
        "text_ru":  "Откуда вы приехали?",
        "text_other":  "Сіз қайдан келдіңіз?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00032",
        "text_ba":  "Мин Өфөнән эш менән (хәбәрсе булып) килдем",
        "text_ru":  "Я приехал(-а) из Уфы по делам (как корреспондент)",
        "text_other":  "Мен Уфадан шаруамен (корреспондент болып) келдім",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00033",
        "text_ba":  "Һеҙгә беҙҙең ҡала оҡшаймы?",
        "text_ru":  "Вам нравится наш город?",
        "text_other":  "Сізге біздің қала ұнады ма?",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00034",
        "text_ba":  "Эйе, оҡшай!",
        "text_ru":  "Да, нравится!",
        "text_other":  "Иә, ұнайды!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00035",
        "text_ba":  "Һау булығыҙ!",
        "text_ru":  "До свидания!",
        "text_other":  "Сау болыңыз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00036",
        "text_ba":  "Хушығыҙ!",
        "text_ru":  "До свидания!",
        "text_other":  "Қош болыңыз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00037",
        "text_ba":  "Яңынан осрашҡанға тиклем!",
        "text_ru":  "До новой встречи!",
        "text_other":  "Қайта кездескенше!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00038",
        "text_ba":  "Иртәгәгә тиклем!",
        "text_ru":  "До завтра!",
        "text_other":  "Ертеңге дейін!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00039",
        "text_ba":  "Тыныс йоҡо!",
        "text_ru":  "Спокойной ночи!",
        "text_other":  "Қайырлы түн!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00040",
        "text_ba":  "Хәйерле юл!",
        "text_ru":  "Счастливого пути!",
        "text_other":  "Жолыңыз болсын!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00041",
        "text_ba":  "... сәләм тапшырығыҙ!",
        "text_ru":  "Передайте привет ...!",
        "text_other":  "Сәлем айтыңыз ...!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00042",
        "text_ba":  "Иртәгә күрешербеҙ!",
        "text_ru":  "Увидимся завтра!",
        "text_other":  "Ертең көрісеміз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00043",
        "text_ba":  "Миңә китергә кәрәк",
        "text_ru":  "Мне надо идти",
        "text_other":  "Маған кету керек",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00044",
        "text_ba":  "Китергә ваҡыт",
        "text_ru":  "Пора уходить",
        "text_other":  "Кететін уақыт болды",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00045",
        "text_ba":  "Беҙгә тағы ла килегеҙ!",
        "text_ru":  "Приезжайте к нам еще!",
        "text_other":  "Бізге тағы да келіңіз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00046",
        "text_ba":  "Онотмағыҙ!",
        "text_ru":  "Не забывайте!",
        "text_other":  "Ұмытпаңыз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00047",
        "text_ba":  "Үпкәләмәгеҙ!",
        "text_ru":  "Не обижайтесь!",
        "text_other":  "Өкпелемеңіз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00048",
        "text_ba":  "Иҫән-һау барып етегеҙ!",
        "text_ru":  "Счастливо вам доехать!",
        "text_other":  "Есен-сау жетіңіз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00049",
        "text_ba":  "Иҫән булығыҙ!",
        "text_ru":  "Счастливо оставаться!",
        "text_other":  "Аман болыңыз!",
        "lang_other":  "kk"
    },
    {
        "id":  "bgpu-kk-00050",
        "text_ba":  "Һеҙҙе байрам менән ҡотлайым!",
        "text_ru":  "Поздравляю вас с праздником!",
        "text_other":  "Мен сізді мерекеңізбен құттықтаймын!",
        "lang_other":  "kk"
    }
]